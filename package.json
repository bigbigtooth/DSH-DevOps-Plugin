{
  "name": "@bigbigtooth/dsh-devops",
  "version": "0.5.0",
  "description": "Remote operations for the DSH Web app: SSH server management, hardware/process/log monitoring, read-only AI inspection, and a Git-to-server deploy loop.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "bigbigtooth",
  "homepage": "https://github.com/bigbigtooth/DSH-DevOps-Plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigbigtooth/DSH-DevOps-Plugin.git"
  },
  "bugs": {
    "url": "https://github.com/bigbigtooth/DSH-DevOps-Plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis",
    "devops",
    "ssh",
    "monitoring",
    "deployment",
    "server-management",
    "ai-ops"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "pack": "pnpm build && pnpm pack --pack-destination dist",
    "test:unit": "vitest run tests/unit",
    "test:contract:dsh": "vitest run tests/integration/contract-dsh",
    "test:integration:ssh": "vitest run tests/integration/ssh",
    "test:integration:ops": "vitest run tests/integration/ops",
    "test:e2e:web": "vitest run tests/e2e",
    "test:acceptance": "vitest run tests/acceptance",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "screenshots.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "schemastery": "^3.18.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "onlyBuiltDependencies": [],
    "ignoredBuiltDependencies": [
      "ws"
    ]
  }
}
